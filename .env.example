# ==============================================================================
# Environment Configuration (.env.example)
# Copy this file to .env for development or .env.test for test suite
# ==============================================================================

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:1234@localhost:5432/holdmyrole?schema=public"

# JSON Web Token Secret (must be a strong secret, at least 32 characters)
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"

# Seed Administrator Credentials
ADMIN_EMAIL="admin@store.dev"
ADMIN_PASSWORD="AdminPassword123!"

# Application Settings
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Cookie Name
COOKIE_NAME="auth_token"
